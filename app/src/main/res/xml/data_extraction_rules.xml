<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Only back up local user game preferences (scores, audio options) -->
        <include domain="sharedpref" path="globoup_prefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="globoup_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>
